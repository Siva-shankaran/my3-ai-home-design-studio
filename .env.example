# MY3 Designs v2 — AI Architectural Design Platform
# Environment Configuration Template
# COPY TO .env.local AND FILL IN CREDENTIALS (NEVER COMMIT .env.local)

# AI Gateway Keys (Optional - Deterministic rules engine runs automatically if omitted)
VITE_NVIDIA_BASE_URL=/api/ai
VITE_NVIDIA_NEMOTRON_KEY=your_nvidia_nemotron_key_here
VITE_NVIDIA_DEEPSEEK_KEY=your_nvidia_deepseek_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Platform Configuration
VITE_PLATFORM_NAME="MY3 Designs"
